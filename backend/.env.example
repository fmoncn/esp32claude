# DeepSeek —— 宠物大脑(对话),https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# LLM 端点(OpenAI 兼容 /chat/completions)。默认指向 DeepSeek 官方,
# 换成自己的反代/其它兼容端点时改这两项即可。
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat
# 仅当你的端点支持 google_search grounding(如自建 Gemini 反代)才设为 1,
# 官方 DeepSeek/OpenAI 兼容端点收到这个字段会直接 400。
LLM_ENABLE_SEARCH=0

# 后端端口
PORT=8787
# 固件必须带上的共享口令(请求头 x-pet-token)。
# 必填:后端默认监听 0.0.0.0 且 CORS 开放,留空=局域网任何人可读你的宠物记忆。
# 必须和 firmware/src/config.h 里的 PET_TOKEN 完全一致。
PET_TOKEN=change-me

# 可选:宠物与主人称呼(persona 用;不填则用默认 克劳德 / 主人 / 主人)
PET_NAME=克劳德
PET_OWNER_NAME=主人
PET_OWNER_TITLE=主人
