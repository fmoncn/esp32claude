# DeepSeek —— 宠物大脑(对话),https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# DashScope —— 语音(STT + TTS),阿里云百炼 https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 小豆丁音色(qwen-tts):Cherry/Chelsie/Serena(女) · Ethan/Dylan(男)
PET_VOICE=Ethan

# 后端端口
PORT=8787
# 可选:固件必须带上的共享口令(请求头 x-pet-token)。留空则不校验。
PET_TOKEN=

# 可选:宠物与主人称呼(persona 用;不填则用默认 小豆丁 / 主人 / 主人)
PET_NAME=小豆丁
PET_OWNER_NAME=主人
PET_OWNER_TITLE=主人
